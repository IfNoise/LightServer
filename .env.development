# Development environment
# Эмулятор Modbus TCP запускается локально на порту 5020

NODE_ENV=development
PORT=3000
WS_PORT=3001

# Storage paths
STORAGE_DEVICES=./storage/devices
STORAGE_CHANNELS=./storage/channels
STORAGE_TIMERS=./storage/timers

# Logging
LOG_LEVEL=debug

# Modbus Emulator
EMULATOR_PORT=5020
EMULATOR_HOST=0.0.0.0
